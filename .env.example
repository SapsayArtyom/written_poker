# Скопировать в .env и подставить значения из Firebase Console
# (Project settings -> Your apps -> Web app -> SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Необязательно — включает Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Локальная разработка на эмуляторах Firebase (npm run emulators).
# Если true — значения выше могут быть любыми непустыми заглушками.
VITE_USE_EMULATORS=false
